{
    "name": "laravel-lang/locales",
    "description": "Basic functionality for working with localizations",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "locale",
        "locales",
        "localization",
        "translation",
        "translations"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Laravel-Lang/mona/issues",
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Locales\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelLang\\Locales\\LocalesServiceProvider"
            ]
        }
    }
}
